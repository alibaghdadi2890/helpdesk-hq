# Copy to .env and fill in. .env is ignored by Git; never commit real values.

# Database: the app connects as helpdesk_app so row-level security applies.
DATABASE_URL=postgres://helpdesk_app:helpdesk_app@localhost:5432/helpdesk
# Migrations and seeding run as the table owner.
MIGRATION_DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
# Port Docker publishes PostgreSQL on. Change it (and both URLs) if 5432 is taken.
DB_PORT=5432

# Model API (Exercise 0.3). Leave empty until then.
LLM_API_KEY=
LLM_MODEL=
# Optional: another base URL for the same API (a proxy or gateway). Leave empty for the default.
LLM_BASE_URL=
# Optional: a stronger model for agents (Chapter 3). Falls back to LLM_MODEL.
LLM_AGENT_MODEL=
# Prices in US dollars per million tokens, copied from your provider's pricing page.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
# Exercise 1.3: the chat loop stops sending after this many tokens.
CHAT_TOKEN_CAP=20000

# Tracing: Phoenix runs in Docker and receives OpenTelemetry traces here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# Development login (POST /auth/dev-login). Disabled when APP_ENV=production.
APP_ENV=development
JWT_SECRET=change-me-in-dev-only-at-least-32-characters
